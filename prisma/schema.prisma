// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum AccountType {
  CASH
  CARD
  BANK
  WALLET
}

enum CategoryType {
  INCOME
  EXPENSE
  BOTH
}

enum PersonRelation {
  FRIEND
  PARTNER
  FAMILY
  COLLEAGUE
  OTHER
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum DebtType {
  LEND
  BORROW
}

enum DebtStatus {
  PENDING
  PARTIAL_SETTLED
  SETTLED
  CANCELLED
}

// MODELS

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  currency  String   @default("INR") // Default ISO code
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  categories   Category[]
  people       Person[]
  transactions Transaction[]
  debts        Debt[]
  transfers    Transfer[]

  @@map("user")
}

model Account {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  accountType    AccountType
  openingBalance Decimal     @default(0.0)
  currentBalance Decimal     @default(0.0)
  currencyType   String      @default("INR")
  isArchived     Boolean?    @default(false)
  color          String?
  icon           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions  Transaction[]
  debts         Debt[]
  fromTransfers Transfer[]    @relation("FromTransfers")
  toTransfers   Transfer[]    @relation("ToTransfers")

  @@unique([userId, name]) // Prevents duplicate account names per user
  @@index([userId])
  @@map("account")
}

model Category {
  id     String  @id @default(cuid())
  userId String? // Nullable to allow global system-default categories
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  categoryType CategoryType @default(EXPENSE)
  color        String?
  icon         String?
  isDefault    Boolean      @default(false)
  isArchived   Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
  @@map("category")
}

model Person {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  email      String? // No global @unique constraint
  relation   PersonRelation @default(FRIEND)
  notes      String?
  isArchived Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  debts        Debt[]

  @@unique([userId, name]) // Ensures unique contact names per user
  @@index([userId])
  @@map("person")
}

model Transaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  debtId String?
  debt   Debt?   @relation(fields: [debtId], references: [id], onDelete: SetNull)

  title           String?
  amount          Decimal
  transactionType TransactionType @default(EXPENSE)
  date            DateTime        @default(now())
  location        String?
  note            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-column query optimization
  @@index([userId, date]) // Main feed timeline & monthly bounds
  @@index([userId, categoryId]) // Category analytics & charts
  @@index([userId, personId]) // Contact transaction histories
  @@index([accountId]) // Account ledger queries
  @@index([debtId]) // Tracking debt repayments
  @@map("transaction")
}

model Debt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  debtType        DebtType   @default(LEND)
  totalAmount     Decimal
  remainingAmount Decimal
  status          DebtStatus @default(PENDING)
  date            DateTime   @default(now())
  note            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([userId, status]) // Active vs settled debt queries
  @@index([userId, personId]) // Debt overview per contact
  @@map("debt")
}

model Transfer {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fromAccountId String
  fromAccount   Account @relation("FromTransfers", fields: [fromAccountId], references: [id], onDelete: Cascade)

  toAccountId String
  toAccount   Account @relation("ToTransfers", fields: [toAccountId], references: [id], onDelete: Cascade)

  amount   Decimal // Amount deducted from fromAccount
  toAmount Decimal? // Optional conversion amount credited to toAccount
  fee      Decimal  @default(0.0) // Service/bank fee charged

  date DateTime @default(now())
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("transfer")
}
